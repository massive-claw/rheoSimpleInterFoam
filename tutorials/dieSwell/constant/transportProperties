FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

phases (water air);

water
{
    transportModel  Newtonian;
    nu              1e-04;
    rho             1000;
}

air
{
    transportModel  Newtonian;
    nu              1e-04;
    rho             100;
}

sigma           0.001;

// Viscoelastic properties
Psi1            [1 -1 0 0 0 0 0] 0.002;
Psi2            [1 -1 0 0 0 0 0] 0.0;

// High-Wi numerical stabilization parameters
lambda          [0 0 1 0 0 0 0] 0.02;
powerN          [0 0 0 0 0 0 0] 0.5;
maxStressRatio  1.0;
maxGammaDot     [0 0 -1 0 0 0 0] 600.0;
relaxTau        0.2;
muNum           [1 -1 -1 0 0 0 0] 0.02;
